{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true
  },
  "include": ["lib", "protocol", "shell", "app", "mock-pds", "mocks", "scripts", "test", "deploy"]
}
